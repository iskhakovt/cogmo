#!/usr/bin/env python3
"""Check the skills this branch changes, with Cogmo's toolchain.

Run from the skills repo as `uv run --locked --group dev .cogmo/verify`.
`COGMO_VERIFY_BASE` names the commit the branch was cut from. The change is
every path that differs from that commit in the working tree: tracked, or
untracked and not ignored. Register's path rules judge it first (`gates.mjs
--paths` in `COGMO_GATES_DIR`, under `node`): one skill's own files in
`skills/<name>/` and nothing else. Then each skill with a changed path is
checked, every check running whatever an earlier one found, with register's
gates, the suppression rule register applies (`.cogmo/suppressions.py`),
ruff, `ruff format --check`, pyrefly with the skill's directory on its
search path, the Imports rule register applies (`.cogmo/imports.py`) against
the dependencies its `SKILL.md` declares, then pytest of its
`test_skill.py`. pyrefly and pytest run with the skill's `requirements.lock`
installed when it has one, and the Imports rule reads that lockfile's
environment. Exits 0 when every check passes or nothing changed, 1 when a
check fails, 2 when the base is missing or unknown, when something changed
and `COGMO_GATES_DIR` or `node` is missing, or when the path rules or the
gates could not run.

Part of Cogmo's toolchain, which Cogmo replaces on each release.
"""

import os
import shutil
import subprocess
import sys
import tempfile
import tokenize
from dataclasses import dataclass, field
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BASE_VARIABLE = "COGMO_VERIFY_BASE"
GATES_VARIABLE = "COGMO_GATES_DIR"
# The gates bundle and the two files it loads by path.
GATES_FILES = ("gates.mjs", "web-tree-sitter.wasm", "tree-sitter-python.wasm")
SKILLS_DIR = "skills"


def git(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["git", *args], cwd=ROOT, capture_output=True, text=True, check=False)


def resolve_base() -> str | None:
    """The commit `COGMO_VERIFY_BASE` names, or None after saying why it names none."""
    base = os.environ.get(BASE_VARIABLE, "")
    if not base:
        print(f"verify: {BASE_VARIABLE} is not set; it names the commit this branch was cut from", file=sys.stderr)
        return None
    resolved = git("rev-parse", "--verify", "--quiet", "--end-of-options", f"{base}^{{commit}}")
    if resolved.returncode != 0:
        print(f"verify: {BASE_VARIABLE}={base} names no commit in this repo", file=sys.stderr)
        return None
    return resolved.stdout.strip()


def resolve_gates() -> Path | None:
    """The directory `COGMO_GATES_DIR` names, holding the gates' three files, or None after saying why it does not."""
    value = os.environ.get(GATES_VARIABLE, "")
    if not value:
        print(f"verify: {GATES_VARIABLE} is not set; it names the directory holding register's gates", file=sys.stderr)
        return None
    gates = Path(value).resolve()
    missing = [name for name in GATES_FILES if not (gates / name).is_file()]
    if missing:
        print(f"verify: {GATES_VARIABLE}={value} holds no {', '.join(missing)}", file=sys.stderr)
        return None
    return gates


def listed(*args: str) -> list[str]:
    result = git(*args)
    if result.returncode != 0:
        raise SystemExit(f"verify: git {args[0]} failed: {result.stderr.strip()}")
    return [path for path in result.stdout.split("\0") if path]


def changed_paths(base: str) -> list[str]:
    """Every path differing from `base` in the working tree, tracked or untracked and not ignored, sorted as git
    sorts register's `main..tip` diff."""
    tracked = listed("diff", "--name-only", "--no-renames", "-z", base, "--")
    untracked = listed("ls-files", "--others", "--exclude-standard", "-z")
    return sorted(set(tracked + untracked))


def changed_skills(paths: list[str]) -> list[str]:
    """The skills with a path among `paths`, whose directories exist."""
    names = {parts[1] for parts in (path.split("/") for path in paths) if len(parts) >= 3 and parts[0] == SKILLS_DIR}
    return sorted(name for name in names if (ROOT / SKILLS_DIR / name).is_dir())


def with_requirements(skill: Path, command: list[str]) -> list[str]:
    """`command`, run with the skill's dependencies installed when it has a lockfile."""
    lockfile = skill / "requirements.lock"
    if (ROOT / lockfile).is_file():
        return ["uv", "run", "--no-build", "--with-requirements", str(lockfile), *command]
    return command


def run_bundle(
    node: str, gates: Path, args: list[str], *, reads: list[Path], stdin: str, label: str
) -> tuple[int, list[str]] | None:
    """`gates.mjs` with `args` and `stdin`, as its exit, 0 or 1, and its stdout's lines; None, after saying why under
    `label`, when it could not run.

    It runs with `NODE_OPTIONS` cleared and under Node's permission model, reading only its own directory and
    `reads`. Node exits 1 with nothing on stdout when it fails before the bundle runs, so only an exit 1 with a line
    is a refusal.
    """
    env = {key: value for key, value in os.environ.items() if key != "NODE_OPTIONS"}
    command = [
        node,
        "--permission",
        f"--allow-fs-read={gates}",
        *(f"--allow-fs-read={path}" for path in reads),
        str(gates / "gates.mjs"),
        *args,
    ]
    result = subprocess.run(command, cwd=ROOT, env=env, input=stdin, capture_output=True, text=True, check=False)
    lines = [line for line in result.stdout.splitlines() if line.strip()]
    if result.returncode == 0 or (result.returncode == 1 and lines):
        return result.returncode, lines
    detail = result.stderr.strip() or f"node exited {result.returncode}" + ("" if lines else " with nothing on stdout")
    print(f"verify: {label}: the gates could not run: {detail}", file=sys.stderr, flush=True)
    return None


def run_gates(node: str, gates: Path, skill: Path, *options: str) -> tuple[int, list[str]] | None:
    """`gates.mjs` on the skill, reading its directory alone (`run_bundle`)."""
    return run_bundle(node, gates, [*options, str(skill)], reads=[ROOT / skill], stdin="", label=skill.name)


def run_path_rules(node: str, gates: Path, paths: list[str]) -> tuple[int, list[str]] | None:
    """`gates.mjs --paths` on the change, its paths NUL-separated on stdin, reading no file (`run_bundle`)."""
    return run_bundle(node, gates, ["--paths"], reads=[], stdin="".join(f"{path}\0" for path in paths), label="paths")


def refused_pragmas(skill: Path) -> list[str]:
    """Each pragma the suppression rule refuses in the skill's Python files, as `path:line:column: message`."""
    # The rule register applies, beside this script; importing it writes no bytecode into the repo.
    sys.dont_write_bytecode = True
    from suppressions import scan

    refused = []
    for path in sorted((ROOT / skill).glob("*.py")):
        relative = path.relative_to(ROOT)
        try:
            scanned = scan(path.read_text(encoding="utf-8"))
        except (SyntaxError, tokenize.TokenError, UnicodeDecodeError) as e:
            refused.append(f"{relative}: the suppression rule cannot read it: {e}")
            continue
        refused.extend(f"{relative}:{r.line}:{r.column}: {r.message}" for r in scanned.refusals)
    return refused


def lockfile_site_packages(lockfile: Path, directory: str) -> str | None:
    """The site-packages of a fresh environment holding the lockfile's distributions and nothing else, built in
    `directory` on this interpreter as register builds the skill's venv; or None after saying why it was not built.

    The environment's own interpreter names it (`sysconfig`, under `-I -S`, so no `.pth` a distribution installs runs).
    """
    env = os.path.join(directory, "env")
    python = os.path.join(env, "bin", "python")
    commands = [
        ["uv", "venv", "--quiet", "--no-project", "--python", sys.executable, env],
        ["uv", "pip", "sync", "--quiet", "--python", python, "--require-hashes", "--only-binary=:all:", str(lockfile)],
        [python, "-I", "-S", "-c", "import sysconfig; print(sysconfig.get_path('purelib'))"],
    ]
    output = ""
    for command in commands:
        result = subprocess.run(command, cwd=ROOT, capture_output=True, text=True, check=False)
        if result.returncode != 0:
            print(f"{lockfile}: its environment was not built: {result.stderr.strip()}", flush=True)
            return None
        output = result.stdout.strip()
    return output


def refused_imports(skill: Path, dependencies: list[str]) -> list[str]:
    """Each import the Imports rule refuses in the skill's `skill.py`, as `path:line:column: message`."""
    # The rule register applies, beside this script, as the suppression rule is.
    sys.dont_write_bytecode = True
    from imports import installed_modules, scan

    path = skill / "skill.py"
    if not (ROOT / path).is_file():
        return []
    installed: dict[str, frozenset[str]] = {}
    lockfile = skill / "requirements.lock"
    with tempfile.TemporaryDirectory(prefix="cogmo-verify-") as directory:
        if (ROOT / lockfile).is_file():
            site_packages = lockfile_site_packages(lockfile, directory)
            if site_packages is None:
                return [f"{path}: the Imports rule cannot read the lockfile's environment"]
            installed = installed_modules(site_packages)
        try:
            refusals = scan((ROOT / path).read_text(encoding="utf-8"), dependencies, installed)
        except (SyntaxError, RecursionError, MemoryError, UnicodeDecodeError) as e:
            return [f"{path}: the Imports rule cannot read it: {e!r}"]
    return [f"{path}:{r.line}:{r.column}: {r.message}" for r in refusals]


@dataclass
class Checked:
    """A skill's checks that failed, and those that could not run."""

    failed: list[str] = field(default_factory=list)
    unrun: list[str] = field(default_factory=list)


def check(name: str, node: str, gates: Path) -> Checked:
    """Run each check on skill `name`, in verify's order, recording the ones that failed or could not run."""
    skill = Path(SKILLS_DIR) / name
    checked = Checked()

    def report(label: str, lines: list[str]) -> None:
        for line in lines:
            print(line, flush=True)
        if lines:
            checked.failed.append(label)

    def run(label: str, command: list[str]) -> None:
        print(f"verify: {name}: {label}", flush=True)
        if subprocess.run(command, cwd=ROOT, check=False).returncode != 0:
            checked.failed.append(label)

    print(f"verify: {name}: gates", flush=True)
    ran = run_gates(node, gates, skill)
    if ran is None:
        checked.unrun.append("gates")
    else:
        status, lines = ran
        for line in lines:
            print(line, flush=True)
        if status == 1:
            checked.failed.append("gates")

    print(f"verify: {name}: suppressions", flush=True)
    report("suppressions", refused_pragmas(skill))

    run("ruff", ["ruff", "check", str(skill)])
    files = [str(skill / file) for file in ("skill.py", "test_skill.py") if (ROOT / skill / file).is_file()]
    if files:
        run("format", ["ruff", "format", "--check", *files])
    run("pyrefly", with_requirements(skill, ["pyrefly", "check", "--search-path", str(skill), str(skill)]))

    print(f"verify: {name}: imports", flush=True)
    declared = run_gates(node, gates, skill, "--dependencies")
    if declared is None:
        checked.unrun.append("imports")
    elif declared[0] == 1:
        print(f"verify: {name} skipped imports: the gates refused its SKILL.md", flush=True)
    else:
        report("imports", refused_imports(skill, declared[1]))

    # Through the interpreter first on PATH, which sees the skill's
    # dependencies; the `pytest` script runs the project's alone.
    run("pytest", with_requirements(skill, ["python", "-m", "pytest", "-q", str(skill / "test_skill.py")]))
    return checked


def check_paths(node: str, gates: Path, paths: list[str]) -> Checked:
    """Register's path rules over the change, printing the refusal register would make."""
    checked = Checked()
    print("verify: paths", flush=True)
    ran = run_path_rules(node, gates, paths)
    if ran is None:
        checked.unrun.append("the path rules")
        return checked
    status, lines = ran
    for line in lines:
        print(line, flush=True)
    if status == 1:
        checked.failed.append("the path rules")
    return checked


def main() -> int:
    os.environ["PYTHONDONTWRITEBYTECODE"] = "1"
    base = resolve_base()
    if base is None:
        return 2
    paths = changed_paths(base)
    if not paths:
        print("verify: nothing changed")
        return 0
    gates = resolve_gates()
    if gates is None:
        return 2
    node = shutil.which("node")
    if node is None:
        print("verify: node is not on PATH; register's gates run under it, so nothing is checked", file=sys.stderr)
        return 2
    # The change first, then each skill whatever it found, so one round shows every finding.
    change = check_paths(node, gates, paths)
    skills = changed_skills(paths)
    results = [("the change", change), *((name, check(name, node, gates)) for name in skills)]
    for name, checked in results:
        if checked.unrun:
            print(f"verify: {name} could not run {', '.join(checked.unrun)}", file=sys.stderr)
        if checked.failed:
            print(f"verify: {name} failed {', '.join(checked.failed)}", file=sys.stderr)
    if any(checked.unrun for _, checked in results):
        return 2
    if any(checked.failed for _, checked in results):
        return 1
    print(f"verify: {', '.join(skills)} passed" if skills else "verify: no skill changed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
