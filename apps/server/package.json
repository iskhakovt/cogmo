{
  "name": "cogmo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "cogmo": {
    "hindsightCompat": ">=1.0.0 <1.1.0"
  },
  "files": [
    "dist",
    "migrations",
    "vendor",
    "data"
  ],
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env scripts/dev-infra.ts",
    "dev:app": "tsx --env-file-if-exists=../../.env watch src/main.ts serve",
    "console": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.dev/env scripts/console.ts",
    "dev:infra": "tsx --env-file-if-exists=../../.env scripts/dev-infra.ts --only",
    "build": "tsc && tsup",
    "typecheck": "tsc",
    "test": "vitest run --project unit --project unit-pyodide",
    "test:integration": "vitest run --project integration",
    "test:record": "RECORD=1 vitest run --project integration",
    "test:record:e2e": "RECORD=1 vitest run --project e2e",
    "test:e2e": "vitest run --project e2e",
    "test:live": "vitest run --project live",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit --project unit-pyodide",
    "tokei": "tsx scripts/tokei.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.dev/env scripts/migrate.ts"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@ai-sdk/fal": "^3.0.66",
    "@ai-sdk/openai-compatible": "^3.0.75",
    "@anthropic-ai/sdk": "^0.137.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@clack/prompts": "^1.8.1",
    "@cogmo/contracts": "workspace:*",
    "@daytona/sdk": "^0.226.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@octokit/request-error": "^7.1.2",
    "@octokit/rest": "^22.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-pino": "^0.69.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@orpc/contract": "1.16.0",
    "@orpc/server": "1.16.0",
    "@t3-oss/env-core": "^0.13.11",
    "@vectorize-io/hindsight-client": "~1.0.0",
    "ai": "^7.0.148",
    "ajv": "^8.20.0",
    "canonicalize": "5.1.0",
    "cmd-ts": "0.15.0",
    "croner": "^10.0.1",
    "dockerode": "5.0.1",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "inngest": "^4.25.0",
    "js-tiktoken": "^1.0.21",
    "jsdom": "^30.1.3",
    "jsonrepair": "^3.15.0",
    "lru-cache": "^11.5.3",
    "marked": "^18.1.1",
    "micro-key-producer": "^0.10.2",
    "mime-types": "^3.0.2",
    "neverthrow": "^8.2.0",
    "openai": "^7.43.0",
    "p-retry": "^8.0.1",
    "picomatch": "^4.0.7",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "pyodide": "^314.0.7",
    "remeda": "^2.53.0",
    "semver": "^7.8.5",
    "sharp": "0.35.5",
    "sirv": "^3.0.2",
    "split2": "4.2.0",
    "ts-pattern": "^5.9.2",
    "web-tree-sitter": "0.27.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.46.0",
    "@electric-sql/pglite": "^0.5.10",
    "@inngest/test": "^1.0.0",
    "@modelcontextprotocol/server-everything": "^2026.8.31",
    "@noble/curves": "^2.4.0",
    "@orpc/client": "1.16.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/dockerode": "4.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "@types/semver": "^7.8.0",
    "@types/split2": "4.2.3",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^12.2.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vitest-mock-extended": "5.1.1",
    "ws": "^8.22.0"
  }
}
