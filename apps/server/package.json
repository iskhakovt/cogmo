{
  "name": "cogmo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "cogmo": {
    "hindsightCompat": ">=0.9.0 <0.10.0"
  },
  "files": [
    "dist",
    "migrations",
    "vendor",
    "data"
  ],
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env scripts/dev-infra.ts",
    "dev:app": "tsx --env-file-if-exists=../../.env watch src/main.ts serve",
    "console": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.dev/env scripts/console.ts",
    "dev:infra": "tsx --env-file-if-exists=../../.env scripts/dev-infra.ts --only",
    "build": "tsc && tsup",
    "typecheck": "tsc",
    "test": "vitest run --project unit --project unit-pyodide",
    "test:integration": "vitest run --project integration",
    "test:record": "RECORD=1 vitest run --project integration",
    "test:record:e2e": "RECORD=1 vitest run --project e2e",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit --project unit-pyodide",
    "tokei": "tsx scripts/tokei.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@ai-sdk/fal": "^3.0.37",
    "@ai-sdk/openai-compatible": "^3.0.44",
    "@anthropic-ai/sdk": "^0.124.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@clack/prompts": "^1.7.0",
    "@cogmo/contracts": "workspace:*",
    "@daytona/sdk": "^0.210.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@octokit/request-error": "^7.1.2",
    "@octokit/rest": "^22.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pino": "^0.68.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@orpc/contract": "1.15.0",
    "@orpc/server": "1.15.0",
    "@t3-oss/env-core": "^0.13.11",
    "@vectorize-io/hindsight-client": "^0.9.2",
    "ai": "^7.0.93",
    "ajv": "^8.20.0",
    "canonicalize": "4.0.0",
    "croner": "^10.0.1",
    "date-fns": "^4.4.0",
    "dockerode": "5.0.1",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.46.0",
    "inngest": "^4.20.0",
    "js-tiktoken": "^1.0.21",
    "jsdom": "^30.0.1",
    "jsonrepair": "^3.15.0",
    "marked": "^18.0.11",
    "micro-key-producer": "^0.10.2",
    "neverthrow": "^8.2.0",
    "openai": "^7.10.0",
    "p-retry": "^8.0.1",
    "picomatch": "^4.0.7",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "pyodide": "^314.0.6",
    "remeda": "^2.45.0",
    "semver": "^7.8.5",
    "sirv": "^3.0.2",
    "split2": "4.2.0",
    "ts-pattern": "^5.9.0",
    "web-tree-sitter": "0.27.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.39.0",
    "@electric-sql/pglite": "^0.5.8",
    "@inngest/test": "^1.0.0",
    "@modelcontextprotocol/server-everything": "^2026.8.31",
    "@noble/curves": "^2.4.0",
    "@orpc/client": "1.15.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/dockerode": "4.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/picomatch": "^4.0.3",
    "@types/semver": "^7.8.0",
    "@types/split2": "4.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "type-fest": "^5.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "vitest-mock-extended": "5.1.1",
    "ws": "^8.21.3"
  }
}
