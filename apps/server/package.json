{
  "name": "cogmo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "cogmo": {
    "hindsightCompat": ">=0.8.0 <0.9.0"
  },
  "files": [
    "dist",
    "migrations",
    "vendor",
    "data"
  ],
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env scripts/dev-infra.ts",
    "dev:app": "tsx --env-file-if-exists=../../.env watch src/main.ts serve",
    "console": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.dev/env scripts/console.ts",
    "dev:infra": "tsx --env-file-if-exists=../../.env scripts/dev-infra.ts --only",
    "build": "tsc && tsup",
    "typecheck": "tsc",
    "test": "vitest run --project unit --project unit-pyodide",
    "test:integration": "vitest run --project integration",
    "test:record": "RECORD=1 vitest run --project integration",
    "test:record:e2e": "RECORD=1 vitest run --project e2e",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit --project unit-pyodide",
    "tokei": "tsx scripts/tokei.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ai-sdk/fal": "^2.0.34",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@anthropic-ai/sdk": "^0.116.0",
    "@aws-sdk/client-s3": "^3.1110.0",
    "@clack/prompts": "^1.7.0",
    "@cogmo/contracts": "workspace:*",
    "@daytonaio/sdk": "^0.175.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@octokit/request-error": "^7.1.1",
    "@octokit/rest": "^22.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.218.0",
    "@opentelemetry/instrumentation-http": "^0.218.0",
    "@opentelemetry/instrumentation-pino": "^0.64.0",
    "@opentelemetry/instrumentation-undici": "^0.28.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@orpc/contract": "1.14.4",
    "@orpc/server": "1.14.4",
    "@t3-oss/env-core": "^0.13.11",
    "@vectorize-io/hindsight-client": "^0.8.1",
    "ai": "^6.0.197",
    "ajv": "^8.20.0",
    "canonicalize": "3.0.0",
    "croner": "^10.0.1",
    "date-fns": "^4.4.0",
    "dockerode": "5.0.1",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.45.1",
    "inngest": "^4.18.1",
    "js-tiktoken": "^1.0.21",
    "jsdom": "^29.1.1",
    "jsonrepair": "^3.15.0",
    "marked": "^18.0.9",
    "micro-key-producer": "^0.8.6",
    "neverthrow": "^8.2.0",
    "openai": "^6.41.0",
    "p-retry": "^8.0.0",
    "picomatch": "^4.0.5",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "pyodide": "^0.29.4",
    "remeda": "^2.39.0",
    "semver": "^7.8.5",
    "sirv": "^3.0.2",
    "split2": "4.2.0",
    "ts-pattern": "^5.9.0",
    "web-tree-sitter": "0.26.12",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.38.0",
    "@electric-sql/pglite": "^0.4.6",
    "@inngest/test": "^1.0.0",
    "@modelcontextprotocol/server-everything": "^2026.7.4",
    "@noble/curves": "^2.2.0",
    "@orpc/client": "1.14.4",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/dockerode": "4.0.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "@types/picomatch": "^4.0.3",
    "@types/semver": "^7.8.0",
    "@types/split2": "4.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "type-fest": "^5.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "4.0.0",
    "ws": "^8.21.3"
  }
}
