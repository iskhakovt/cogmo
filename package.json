{
  "name": "assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "dev": "tsx scripts/dev-infra.ts",
    "dev:app": "tsx watch src/index.ts",
    "console": "tsx scripts/console.ts",
    "dev:infra": "tsx scripts/dev-infra.ts --only",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:record": "LLMOCK_RECORD=1 vitest run --project integration",
    "test:record:e2e": "LLMOCK_RECORD=1 vitest run --project e2e",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@aws-sdk/client-s3": "^3.1026.0",
    "@mozilla/readability": "^0.6.0",
    "@t3-oss/env-core": "^0.13.11",
    "@vectorize-io/hindsight-client": "^0.5.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.41.1",
    "inngest": "^4.2.0",
    "js-tiktoken": "^1.0.21",
    "jsdom": "^29.0.2",
    "neverthrow": "^8.2.0",
    "openai": "^6.33.0",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.8",
    "remeda": "^2.33.7",
    "superjson": "^2.2.6",
    "ts-pattern": "^5.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@copilotkit/aimock": "^1.8.0",
    "@electric-sql/pglite": "^0.4.2",
    "@inngest/test": "^1.0.0",
    "@testcontainers/ollama": "^11.13.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "pino-pretty": "^13.1.3",
    "telegram-test-api": "^4.2.1",
    "testcontainers": "^11.13.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "type-fest": "^5.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  }
}
