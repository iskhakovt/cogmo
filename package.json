{
  "name": "cogmo-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.13.0+sha512.1e55719bf26e809dce5c5084fdebaa64efb3da9038ae5d68a9f8a68311f1a45841c8c3b76a37298c3b66f6bcc80409a9b7f33c78a7168a3e90fb65a5d8235ae4",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter cogmo build",
    "dev": "pnpm --filter cogmo dev",
    "dev:app": "pnpm --filter cogmo dev:app",
    "dev:web": "pnpm --filter web dev",
    "dev:infra": "pnpm --filter cogmo dev:infra",
    "console": "pnpm --filter cogmo console",
    "tokei": "pnpm --filter cogmo tokei",
    "test": "pnpm --filter cogmo test",
    "test:integration": "pnpm --filter cogmo test:integration",
    "test:record": "pnpm --filter cogmo test:record",
    "test:record:e2e": "pnpm --filter cogmo test:record:e2e",
    "test:e2e": "pnpm --filter cogmo test:e2e",
    "test:live": "pnpm --filter cogmo test:live",
    "test:all": "pnpm --filter cogmo test:all",
    "test:watch": "pnpm --filter cogmo test:watch",
    "db:generate": "pnpm --filter cogmo db:generate",
    "db:migrate": "pnpm --filter cogmo db:migrate",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "husky": "^9.1.7",
    "knip": "6.42.1"
  }
}
