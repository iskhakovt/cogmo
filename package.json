{
  "name": "cogmo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env scripts/dev-infra.ts",
    "dev:app": "tsx --env-file-if-exists=.env watch src/main.ts serve",
    "console": "tsx --env-file-if-exists=.env --env-file-if-exists=.dev/env scripts/console.ts",
    "dev:infra": "tsx --env-file-if-exists=.env scripts/dev-infra.ts --only",
    "build": "tsc && tsup",
    "typecheck": "tsc",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:record": "LLMOCK_RECORD=1 vitest run --project integration",
    "test:record:e2e": "LLMOCK_RECORD=1 vitest run --project e2e",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "tokei": "tsx scripts/tokei.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ai-sdk/fal": "^2.0.33",
    "@anthropic-ai/sdk": "^0.94.0",
    "@aws-sdk/client-s3": "^3.1039.0",
    "@clack/prompts": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@octokit/request-error": "^7.1.0",
    "@octokit/rest": "^22.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.216.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.216.0",
    "@opentelemetry/instrumentation-http": "^0.216.0",
    "@opentelemetry/instrumentation-pino": "^0.62.0",
    "@opentelemetry/instrumentation-undici": "^0.26.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.216.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@t3-oss/env-core": "^0.13.11",
    "@vectorize-io/hindsight-client": "^0.5.6",
    "ai": "^6.0.175",
    "ajv": "^8.20.0",
    "date-fns": "^4.1.0",
    "dockerode": "5.0.0",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.42.0",
    "inngest": "^4.2.6",
    "js-tiktoken": "^1.0.21",
    "jsdom": "^29.1.1",
    "marked": "^18.0.3",
    "micro-key-producer": "^0.8.6",
    "neverthrow": "^8.2.0",
    "openai": "^6.36.0",
    "p-retry": "^8.0.0",
    "picomatch": "^4.0.4",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "pyodide": "^0.29.3",
    "remeda": "^2.33.7",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@copilotkit/aimock": "^1.15.1",
    "@electric-sql/pglite": "^0.4.5",
    "@inngest/test": "^1.0.0",
    "@modelcontextprotocol/server-everything": "^2026.1.26",
    "@noble/curves": "^2.2.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/dockerode": "4.0.1",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.6.0",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^11.14.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "type-fest": "^5.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
