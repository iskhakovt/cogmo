# Deny all, allow only what the Dockerfile COPYs.
# Keeps the build context small and prevents accidental secret inclusion.
*

# Build inputs (must match Dockerfile COPY lines)
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!patches/
!apps/
!packages/

# Re-exclude artifacts, deps, tests, and any local secrets from the context.
# These come after the allow-list, so last-match-wins keeps them out.
**/node_modules/
apps/server/dist/
apps/web/dist/
apps/server/test/
apps/server/src/**/*.test.ts
**/.env
**/.env.*
