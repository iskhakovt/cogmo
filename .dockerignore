# Deny all, allow only what the Dockerfile COPYs.
# Default-deny keeps the build context minimal and prevents accidental
# secret inclusion (.dev/env, .npmrc, keys never enter the context).
*

# Root workspace manifests. Re-add `!patches/` alongside a `COPY patches/`
# in the Dockerfile if `pnpm-workspace.yaml` ever regains `patchedDependencies`
# — the frozen install fails loudly when a declared patch is missing, so the
# two can't drift silently.
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml

# Descend into apps/ + packages/ to reach the specific COPYed inputs. A
# nested path can only be re-included after its parents are, so each level
# un-excludes the dir, re-excludes its children, then allows what we COPY.
!apps/
apps/*
!apps/server/
apps/server/*
!apps/server/package.json
!apps/server/tsconfig.json
!apps/server/tsup.config.ts
!apps/server/src/
!apps/server/migrations/
!apps/server/vendor/
!apps/server/data/
!apps/web/
apps/web/*
!apps/web/package.json
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!apps/web/index.html
!apps/web/src/
!packages/
packages/*
!packages/contracts/

# Trim what the build doesn't need from the allowed trees.
apps/server/src/test/
apps/server/src/**/*.test.ts
**/node_modules/
**/dist/
